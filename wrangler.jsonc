// Game server: party/server.ts runs each party in a Durable Object (PartyServer).
// Local: `npm run dev:party` (wrangler dev on :1999). Deploy: `npx wrangler deploy`.
// Secrets (never in this file): `npx wrangler secret put YOUTUBE_API_KEY` / `ANTHROPIC_API_KEY`;
// locally they come from a gitignored .dev.vars. Optional: PAID_DAILY_CAP, also as a secret so a deploy keeps it (party/paid.ts).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hitster-online",
  "main": "party/server.ts",
  "compatibility_date": "2026-10-01",
  // resolveEnv (lib/playlist-resolver.ts) falls back to process.env.
  "compatibility_flags": ["nodejs_compat"],
  // Binding names map to URL party names: Main → /parties/main/<room>, etc. (party/room.ts PARTY_BINDINGS)
  "durable_objects": {
    "bindings": [
      { "name": "Main", "class_name": "Main" },
      { "name": "Playlist", "class_name": "Playlist" },
      { "name": "Library", "class_name": "Library" },
      { "name": "Paid", "class_name": "Paid" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Main", "Playlist", "Library", "Paid"] }],
  "observability": { "enabled": true }
}
