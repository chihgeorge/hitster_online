# YouTube Data API v3 — https://console.cloud.google.com
# Enable "YouTube Data API v3", create an API key (server-side only, restrict to this domain)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Anthropic API key — https://console.anthropic.com
# Used for AI-based music metadata resolution (title, artist, release year).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PartyKit host — set to your deployed PartyKit URL in production
# Leave as localhost:1999 for local dev (partykit dev starts on this port)
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999
