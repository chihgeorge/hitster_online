# YouTube Data API v3 — https://console.cloud.google.com
# Enable "YouTube Data API v3", create an API key (server-side only, restrict to this domain)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Anthropic API key — https://console.anthropic.com
# Used for AI-based music metadata resolution (title, artist, release year).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Game server host (party/server.ts on Cloudflare) — in production, the worker's host, e.g. hitster-online.<subdomain>.workers.dev
# Leave as localhost:1999 for local dev (`npm run dev:party` starts wrangler dev on this port)
# The server's own YOUTUBE_API_KEY / ANTHROPIC_API_KEY go in a gitignored .dev.vars locally and in `wrangler secret put` for deploys.
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999
